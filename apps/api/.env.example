# DutyWise API — environment template
# Copy to .env (local dev) or set in Dokploy compose environment (production).

NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://dutywise:dutywise_dev_password@localhost:5432/dutywise
JWT_SECRET=generate_a_random_secret_at_least_32_chars_long
SEED_DEMO=true
SANDBOX_MODE=true
# ALLOWED_ORIGIN=https://dutywise.dok.cerf.codes
