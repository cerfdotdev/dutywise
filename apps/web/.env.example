# Web — DutyWise apps/web
# Copy to .env (or .env.local) and adjust. Never commit real values.

# Backend API base (internal, server-side proxy target). No trailing /api.
API_INTERNAL_URL=http://localhost:8000

# Public origin used for metadata / OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Renders the sandbox/demo notice bar site-wide.
NEXT_PUBLIC_SANDBOX_NOTICE=true
