{
  "name": "@dutywise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DutyWise API \u2014 customs brokerage as a service (sandbox)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "jose": "6.2.8",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "pino-pretty": "^13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
