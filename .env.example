# ————— DutyWise environment — copy to .env and fill —————
# Never commit real values.

# Postgres
POSTGRES_USER=dutywise
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=dutywise

# API
DATABASE_URL=postgres://dutywise:change_me_strong_password@localhost:5432/dutywise
JWT_SECRET=generate_a_random_64_char_secret
SEED_DEMO=true
SANDBOX_MODE=true

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANDBOX_NOTICE=true
